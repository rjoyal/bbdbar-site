  "redirects": [
    {
      "source": "/recipes/:path*",
      "destination": "/blog/:path*",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "bluebirdmobiledessertbar.com" }],
      "destination": "https://bbdbar.com/$1",
      "statusCode": 301
    },
    {
      "source": "/experiences",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/quote",
      "destination": "/inquire",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/inquire",
      "permanent": true
    },
    {
      "source": "/contact-gad",
      "destination": "/inquire",
      "permanent": true
    },
    {
      "source": "/eb",
      "destination": "/",
      "permanent": true
    }
  ]
}
