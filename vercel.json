      "destination": "https://bbdbar.com/$1",
      "permanent": true
    },
    {
      "source": "/experiences",
      "destination": "/services",
      "permanent": true
    },
    {
      "source": "/quote",
      "destination": "/inquire",
      "permanent": true
    }
  ]
}
